    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "postcss": "8.5.6",
