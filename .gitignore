# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- node / next ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# --- data ---
#
# The research archive is deliberately unbounded and deliberately untracked. It
# preserves the full order-book ladders, trade prints and raw payloads that the
# PRODUCT snapshot must prune to stay under its 40 MiB ceiling. Two stores with
# opposite requirements: one bounded and committed, one durable and local.
# Back it up separately - nothing in git will do it for you.
data/research-archive.db
data/research-archive.db-*
data/payloads/
data/*.db
data/*.db-wal
data/*.db-shm
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Raw forward recordings: full L2 ladders and the tape, several MB per hour per
# event. The same bargain as the research archive - the evidence is durable and
# local, the *findings* are committed. Every derived file below is tracked,
# including the ledgers that hold the losing observations, because a repository
# that kept only the summary would be unable to show that the losers were kept.
artifacts/forward/**/snapshots.jsonl
artifacts/forward/**/markets.jsonl
artifacts/forward/**/trades.jsonl
artifacts/forward/**/books.jsonl
artifacts/forward/**/observations.jsonl
artifacts/forward/**/prices.jsonl

# --- customer records (never commit) ---
#
# Founding Pilot fulfilment is manual, so the member ledger is a file rather than
# a database. It holds email addresses, Stripe payment identifiers and delivery
# history - personal data belonging to paying customers, which must never enter
# git history, where it cannot be deleted on request.
#
# The committed template is docs/founding-pilot-customers.template.md.
private/

# Belt and braces for the outreach research folder.
#
# `founding-trader/` sat at the repository root, untracked but NOT ignored, so
# it appeared in every `git status` as an available `??` entry and one `git add
# -A` would have committed a prospect ledger with names, contact details and
# outreach history into a public repository - where deletion does not remove it.
#
# The folder now lives under `private/` and is covered by the rule above. These
# patterns exist because being untracked is not a protection: it is the state
# immediately before being tracked. If any tool or habit recreates the folder at
# the old path, it stays ignored.
/founding-trader/
**/customer_ledger.csv
**/*outreach_log*.md

# --- os / editor ---
.DS_Store
.idea/
.vscode/
*.log
.vercel

# Agent/tooling scratch directories (never part of the repository)
**/.*.tmpdir/

# The deployment snapshot IS committed, deliberately.
#
# Vercel auto-deploys on every push to main, and a git-triggered build only contains
# what is in the repository. While this file was gitignored, each push produced a
# bundle with no database, the API crashed on import, and a healthy CLI deploy was
# silently replaced by a broken one - three separate production outages.
#
# Committing it makes git and CLI deploys produce identical, working bundles.
# Rebuild with `make snapshot-build` (deterministic, fixed RNG seed).

# Personal job-search material. This repository is public: an interview brief
# committed here is published, indexed, and stays in history after deletion.
docs/TENCENT_*.md
docs/*INTERVIEW*.md
docs/*_BRIEF_*.md

# Extension build output and rendered previews
apps/extension/dist/
apps/extension/out/
apps/extension/node_modules/
# Vitest's transient config-bundle scratch files
apps/extension/vitest.config.ts.timestamp-*.mjs

# Local browser binaries for the load harness. A 50 MB Chrome archive must not
# live in git (it bloats objects, drifts with every Chrome release, and is
# platform-specific). The harness uses CHROME_PATH or the system Chrome; a
# pinned Chrome-for-Testing archive stays a local download.
apps/extension/chrome/

# Runtime collector logs written by the launchd agent. Tracked by mistake in
# the 4C0.9 commit; they churn the working tree on every capture and would
# make "working tree clean" meaningless as a verification signal.
logs/

# Operator runtime state, never source. A committed DEMO_ARMED would arm demo
# execution for every checkout until it expired; a committed EXECUTION_DISABLED
# would silently kill execution for everyone else.
data/DEMO_ARMED
data/EXECUTION_DISABLED

# Calibration study inputs: the settled-market listing and the candles pulled for it.
# Reproducible from the collector; the pre-registration, scripts and results are tracked.
artifacts/research/**/rows.jsonl
artifacts/research/**/quotes.jsonl
