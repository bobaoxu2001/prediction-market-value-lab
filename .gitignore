# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- node / next ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# --- data ---
data/*.db
data/*.db-wal
data/*.db-shm
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# --- os / editor ---
.DS_Store
.idea/
.vscode/
*.log
.vercel

# The deployment snapshot IS committed, deliberately.
#
# Vercel auto-deploys on every push to main, and a git-triggered build only contains
# what is in the repository. While this file was gitignored, each push produced a
# bundle with no database, the API crashed on import, and a healthy CLI deploy was
# silently replaced by a broken one - three separate production outages.
#
# Committing it makes git and CLI deploys produce identical, working bundles.
# Rebuild with `make snapshot-build` (deterministic, fixed RNG seed).
