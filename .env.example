# ============================================================================
#  Prediction Market Value Lab - environment template
#  Copy to `.env` and edit. `.env` is gitignored and must never be committed.
#  Every value below is a PLACEHOLDER - no real credential belongs in this file.
# ============================================================================

ENVIRONMENT=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# Default (leave blank): local SQLite at ./data/pmvl.db - no infrastructure needed.
# PostgreSQL (matches docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://pmvl:pmvl@localhost:5432/pmvl
DATABASE_URL=

# ---------------------------------------------------------------- providers
# Kalshi and Polymarket PUBLIC market data require NO credentials.
# The research platform never authenticates. The keys below exist only for a
# future, isolated execution service and are unused in this release.
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=

POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_DATA_BASE=https://data-api.polymarket.com
POLYMARKET_WS_BASE=wss://ws-subscriptions-clob.polymarket.com/ws

# Free, keyless data sources backing the category probability models.
COINBASE_API_BASE=https://api.exchange.coinbase.com
# Yahoo's public chart endpoint, keyless; backs the equity index threshold model.
YAHOO_FINANCE_BASE=https://query1.finance.yahoo.com
NWS_API_BASE=https://api.weather.gov
# api.weather.gov requires a self-identifying User-Agent. Put a real contact here.
HTTP_USER_AGENT=prediction-market-value-lab/0.1 (research; contact: you@example.com)

# ---------------------------------------------------------------- research LLM
# Optional. When RESEARCH_ENABLED=false (default) the NullResearchProvider is used:
# it contributes no evidence and no probability weight, rather than inventing text.
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-sonnet-5
RESEARCH_ENABLED=false

# ---------------------------------------------------------------- http client
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=4
HTTP_MAX_CONCURRENCY=6
CIRCUIT_BREAKER_THRESHOLD=8
CIRCUIT_BREAKER_RESET_SECONDS=120

# ---------------------------------------------------------------- ingest scope
INGEST_MARKET_LIMIT=1200
INGEST_ORDERBOOK_LIMIT=250
ORDERBOOK_DEPTH=25
MIN_VOLUME_24H_USD=500
MIN_ORDERBOOK_NOTIONAL_USD=25

# ---------------------------------------------------------------- economics
SLIPPAGE_TICKS=1
CAPITAL_COST_ANNUAL_RATE=0.05
POLYMARKET_TRANSFER_COST_USD=0.50
KELLY_FRACTION=0.25
MIN_CONSERVATIVE_NET_EV=0.005
CROSS_PLATFORM_EXECUTION_RISK_USD=0.01

# Minimum NET edge (fraction of capital) before an arbitrage is published.
# Cross-venue legs add settlement-source divergence, two close times, split capital
# and withdrawal cost - none recoverable if one leg fills and the other does not -
# so they clear a higher bar. Thin books are the harder case in both spans.
MIN_EDGE_SAME_PLATFORM_LIQUID=0.015
MIN_EDGE_SAME_PLATFORM_NORMAL=0.03
MIN_EDGE_CROSS_PLATFORM=0.04
MIN_EDGE_CROSS_PLATFORM_ILLIQUID=0.05
LIQUID_DEPTH_THRESHOLD_USD=2000
MAX_QUOTE_AGE_SECONDS=300

# ---------------------------------------------------------------- snapshots
DAILY_SNAPSHOT_HOUR_UTC=13
DAILY_SNAPSHOT_MINUTE_UTC=0
TOP_N=10

# ---------------------------------------------------------------- data policy
# When false, demo fixtures cannot be written to the database at all.
ALLOW_DEMO_DATA=true

# ---------------------------------------------------------------- compliance
# Advisory gate for the future execution surface. Research is read-only and global.
RESTRICTED_REGIONS=US-restricted-states,UK,FR,BE,SG,TH,PL,ON
TRADING_EXECUTION_ENABLED=false

API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---------------------------------------------------------------- public site
# Absolute origin of the public deployment, no trailing path. Used for canonical
# URLs, the sitemap and - critically - the Stripe redirect allowlist, so a wrong
# value here degrades to localhost rather than to somebody else's domain.
# Leave blank on Preview: the code falls back to the project's production host
# rather than baking an ephemeral deployment hostname into canonical tags.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- accounts
# Clerk. Both are required together: a publishable key alone renders the sign-in
# UI but cannot verify a session server-side, and the application treats that as
# "not configured" rather than as half-working authentication.
# Use TEST keys everywhere until the live-launch checklist is complete.
# Setup: docs/saas-setup.md
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------- billing
# Setting the public flag alone must NEVER activate billing. It is inlined into
# the browser bundle and decides only whether checkout buttons render; the server
# gate below decides whether a Checkout Session can be created at all.
#
# Safe production state:   NEXT_PUBLIC_BILLING_ENABLED=false, BILLING_MODE=disabled
# Preview demonstration:   NEXT_PUBLIC_BILLING_ENABLED=true,  BILLING_MODE=test
NEXT_PUBLIC_BILLING_ENABLED=false

# `disabled` or `test`. There is deliberately no `live`: going live is a reviewed
# code change, not an environment variable. A sk_live_ key is REJECTED, so
# shipping the wrong secret disables billing rather than enabling real payments.
BILLING_MODE=disabled

# Stripe, test mode only. Billing enables only when ALL FOUR are present.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
